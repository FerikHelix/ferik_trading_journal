---
import '../styles/global.css';
import Sidebar from '../components/shell/Sidebar.astro';
import Topbar from '../components/shell/Topbar.astro';
import MobileNav from '../components/shell/MobileNav.astro';
import { findNav } from '../lib/nav';
import { themeBootstrap } from '../lib/theme/bootstrap';
import { DARK_META } from '../lib/theme';

interface Props { title: string; description?: string; active: string; }
const {
  title,
  description = 'FerikTrading — fundamental, sinyal SMC, dan jurnal trading dalam satu workspace lokal.',
  active,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const crumb = findNav(active);
---
<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={DARK_META} />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title} · FerikTrading</title>
    <script is:inline set:html={themeBootstrap()} />
  </head>
  <body>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <div class="app-shell" data-nav-open="false">
      <Sidebar active={active} base={base} />
      <div class="app-shell__backdrop" data-nav-close aria-hidden="true"></div>
      <div class="app-main">
        <Topbar groupLabel={crumb?.group.label ?? null} pageLabel={crumb?.item.title ?? title} />
        <main class="content" id="konten"><slot /></main>
      </div>
      <MobileNav active={active} base={base} />
    </div>
    <script is:inline>
      (() => {
        const shell = document.querySelector('.app-shell');
        if (!shell) return;
        const set = (open) => {
          shell.dataset.navOpen = String(open);
          document.body.style.overflow = open ? 'hidden' : '';
        };
        document.querySelector('[data-nav-toggle]')?.addEventListener('click', () => {
          set(shell.dataset.navOpen !== 'true');
        });
        document.querySelectorAll('[data-nav-close]').forEach((el) => {
          el.addEventListener('click', () => set(false));
        });
        document.querySelectorAll('.sidebar .nav__link').forEach((el) => {
          el.addEventListener('click', () => set(false));
        });
        addEventListener('keydown', (event) => { if (event.key === 'Escape') set(false); });
      })();
    </script>
  </body>
</html>
